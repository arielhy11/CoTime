rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function sessionData(sessionId) {
      return get(/databases/$(database)/documents/sessions/$(sessionId)).data;
    }

    function isParticipant(sessionId) {
      return signedIn() && request.auth.uid in sessionData(sessionId).playerIds;
    }

    // ── Profiles ──────────────────────────────────────────────────────────
    match /users/{uid} {
      allow read: if signedIn();
      allow create, update: if isSelf(uid)
        && request.resource.data.keys().hasOnly(['name', 'photoURL', 'createdAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1
        && request.resource.data.name.size() <= 20
        && (request.resource.data.photoURL == null
            || (request.resource.data.photoURL is string
                && request.resource.data.photoURL.size() < 300000));
      allow delete: if false;
    }

    // ── Games ─────────────────────────────────────────────────────────────
    match /sessions/{sessionId} {
      // Anyone signed in can look a lobby up by its code.
      allow read: if signedIn();

      allow create: if signedIn()
        && request.resource.data.hostId == request.auth.uid
        && request.resource.data.playerIds == [request.auth.uid]
        && request.resource.data.status == 'lobby';

      // Settings that never change after creation.
      function settingsUnchanged() {
        return !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['hostId', 'code', 'mode', 'stake', 'durationMinutes', 'lives', 'timeBankSeconds', 'createdAt']);
      }

      function joining() {
        return resource.data.status == 'lobby'
          && !(request.auth.uid in resource.data.playerIds)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['playerIds', 'aliveIds'])
          && request.resource.data.playerIds.size() == resource.data.playerIds.size() + 1
          && request.auth.uid in request.resource.data.playerIds
          && request.resource.data.playerIds.size() <= 12;
      }

      function starting() {
        return resource.data.status == 'lobby'
          && request.resource.data.status == 'live'
          && request.auth.uid == resource.data.hostId;
      }

      function playing() {
        return request.auth.uid in resource.data.playerIds
          && resource.data.status != 'lobby'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status', 'aliveIds', 'endedAt', 'endReason', 'loserId', 'winnerId', 'rankedIds', 'rematchSessionId'
          ]);
      }

      function leavingLobby() {
        return resource.data.status == 'lobby'
          && request.auth.uid in resource.data.playerIds
          && (
            (request.auth.uid == resource.data.hostId
              && request.resource.data.status == 'finished')
            || (request.auth.uid != resource.data.hostId
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['playerIds', 'aliveIds'])
              && !(request.auth.uid in request.resource.data.playerIds))
          );
      }

      allow update: if signedIn() && settingsUnchanged()
        && (joining() || starting() || playing() || leavingLobby());

      allow delete: if false;

      match /players/{uid} {
        allow read: if signedIn();
        allow create: if isSelf(uid) && request.resource.data.pickupCount == 0;
        // Your own row; or anyone at the table:
        //  - knocking out a Time Bank player whose bank ran dry in their hand
        //  - counting a pickup for a player whose phone never reached the table
        allow update: if isSelf(uid)
          || (isParticipant(sessionId)
              && request.resource.data.isOut == true
              && request.resource.data.diff(resource.data).affectedKeys()
                   .hasOnly(['isHolding', 'holdingSince', 'offTableMs', 'longestHoldMs', 'isOut', 'outAt']))
          || (isParticipant(sessionId)
              && resource.data.isPlaced == false
              && resource.data.isHolding == false
              && request.resource.data.pickupCount == resource.data.pickupCount + 1
              && request.resource.data.diff(resource.data).affectedKeys()
                   .hasOnly(['pickupCount', 'isHolding', 'holdingSince', 'firstPickupAt', 'isOut', 'outAt']));
        allow delete: if isSelf(uid);
      }

      match /events/{eventId} {
        allow read: if signedIn();
        allow create: if signedIn()
          && (request.resource.data.userId == request.auth.uid
              || (request.resource.data.type in ['eliminated', 'pickup'] && isParticipant(sessionId)));
        allow update, delete: if false;
      }
    }
  }
}
