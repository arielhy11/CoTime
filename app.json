{
  "expo": {
    "name": "CoTime",
    "slug": "CoTime",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "cotime",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0D0A14",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.cotime.app",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "CoTime uses the camera for your profile selfie (the one your friends get to blow up).",
        "NSPhotoLibraryUsageDescription": "CoTime uses your photo library so you can pick a profile picture.",
        "NSMotionUsageDescription": "CoTime uses motion sensors to tell when you pick your phone up during a game."
      }
    },
    "android": {
      "package": "com.cotime.app",
      "versionCode": 1,
      "icon": "./assets/images/icon.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#0D0A14"
      },
      "edgeToEdgeEnabled": true,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.VIBRATE",
        "android.permission.HIGH_SAMPLING_RATE_SENSORS"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0D0A14"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "CoTime uses your photo library so you can pick a profile picture.",
          "cameraPermission": "CoTime uses the camera for your profile selfie (the one your friends get to blow up)."
        }
      ],
      [
        "expo-sensors",
        {
          "motionPermission": "CoTime uses motion sensors to tell when you pick your phone up during a game."
        }
      ],
      "expo-audio",
      "expo-font",
      "expo-localization"
    ],
    "experiments": {
      "typedRoutes": true,
      "baseUrl": "/cotime"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "extra": {
      "router": {}
    }
  }
}
